data/
__pycache__/
*.egg-info/
.pytest_cache/
.venv/

# Run outputs are ignored above, but the artifacts that make a result
# reproducible are NOT: readouts, scores, scored rows, candidate pools.
# (The blanket data/ rule silently dropped the first pilot's results.)
!data/
data/*
!data/*/
data/*/*
!data/*/prereg_readout.json
!data/*/scores*.json
!data/*/pilot_free_scored*.jsonl
!data/*/candidates.jsonl
!data/*/gold_errors.json
!data/*.json
# pre-outcome, tamper-evident records must be committed:
!data/*/CHECKPOINT_HASHES.json
# readouts the paper quotes must be committed:
!data/*/readout_*.json
!data/*/rescoring_bundle.jsonl
silentfail_l4_package*
